<?xml version="1.0" encoding="utf-8"?>
<!--
   GrowthEngine data extraction rules for Android 12+ (API 31+).
   Controls cloud backup and device-to-device transfer behavior.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include Room database for data recovery -->
        <include domain="database" path="growthengine_database" />
        <include domain="sharedpref" path="growth_engine_auth_prefs.xml" />

        <!-- Exclude sensitive credentials and tokens -->
        <exclude domain="sharedpref" path="growth_engine_secure_prefs.xml" />
        <exclude domain="sharedpref" path="growthengine_ai_usage.xml" />
        <exclude domain="sharedpref" path="growthengine_supabase_prefs.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- Allow database transfer for device migration -->
        <include domain="database" path="growthengine_database" />
        <include domain="sharedpref" path="growth_engine_auth_prefs.xml" />

        <!-- Never transfer encrypted credentials -->
        <exclude domain="sharedpref" path="growth_engine_secure_prefs.xml" />
        <exclude domain="sharedpref" path="growthengine_supabase_prefs.xml" />
    </device-transfer>
</data-extraction-rules>

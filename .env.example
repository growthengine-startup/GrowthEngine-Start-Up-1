# ============================================================
# GrowthEngine Production Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the .env file to version control.
#
# For AI Studio builds, keys are injected from the Secrets panel.
# For local builds, set them in .env at the project root.
# ============================================================

# GEMINI API KEY (Required for AI Copilot)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=MY_GEMINI_API_KEY

# RAZORPAY CREDENTIALS (Required for payment processing)
# Get from: https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxx

# SUPABASE CREDENTIALS (Required for cloud sync)
# Get from: https://supabase.com/dashboard/project/<id>/settings/api
# SUPABASE_URL=https://<project-id>.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# GOOGLE SIGN-IN (Required for Google OAuth)
# Get from: https://console.cloud.google.com/apis/credentials
# Use the WEB client ID (not Android client ID)
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# KEYSTORE_PATH=/path/to/my-upload-key.jks
# STORE_PASSWORD=your_store_password
# KEY_PASSWORD=your_key_password
